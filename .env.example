# Copy to .env and adjust as needed. Every default below matches what was previously
# hardcoded across factory/*.py, so an absent .env changes nothing.

DDA_WINAPPDRIVER_HOST=127.0.0.1
DDA_WINAPPDRIVER_PORT=4723

DDA_TARGET_EXE_NAME=DellDataAssistant.TargetPc.exe
DDA_TARGET_PROCESS_NAME=DellDataAssistant.TargetPc

# No installer exists for the Release build -- set this to wherever it was extracted on
# YOUR machine. Only read by tools/_test_full_signin.py and
# tools/_test_cancel_and_retry_live.py; tools/run_sign_in_flow.py takes --build-path
# (or prompts) instead.
#DDA_TARGET_BUILD_PATH=C:\path\to\DellDataAssistant.TargetPc.exe

DDA_MOCK_SERVER_PORT=8443

# Comma-separated, checked in order -- the OS default browser varies per machine.
DDA_BROWSER_PROCESS_NAMES=chrome,msedge

# Semicolon-separated search paths (Windows paths may contain commas).
DDA_WINAPPDRIVER_INSTALL_PATHS=C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe;C:\Program Files\Windows Application Driver\WinAppDriver.exe
DDA_NODE_INSTALL_PATHS=C:\Program Files\nodejs\node.exe;C:\Program Files (x86)\nodejs\node.exe

# NOT loaded from this file -- credentials are real environment variables only (see
# PROJECT_PLAN.md Sec 4.7/7), never committed here. Set these in your actual shell
# environment before running tools/run_sign_in_flow.py:
#   DDA_TARGET_SIGNIN_USERNAME=
#   DDA_TARGET_SIGNIN_PASSWORD=
#   DDA_TARGET_OTP_STATIC_VALUE=
