# Local secrets -- real credentials/config, never committed. .env.example is the
# tracked template; see PROJECT_PLAN.md Sec 4.7/7.
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/

# Everything generated under reports/output/ -- never pushed, whatever form a report or
# its artifacts take (per explicit user direction: the folder where reports get
# generated must never be pushed). Blanket rule rather than enumerated file types/
# subfolders, so a future report format can't accidentally slip through. .gitkeep stays
# tracked so the empty folder structure still exists in a fresh clone.
reports/output/*
!reports/output/.gitkeep

# Same reasoning, for validation/validate_migration.py's own generated HTML reports.
validation/output/*
!validation/output/.gitkeep

# Coordination Service's own runtime state (published pairing codes etc.) -- generated
# at runtime, never meant to be committed, same reasoning as reports/output/ above.
coordination_service/state.json

# Markdown docs are kept local only, except the root README, CLAUDE.md (the standing
# architecture/conventions reference for AI-assisted sessions on this repo),
# DIALOG_HANDLING.md (the dialog-polling catalog), TEST_SCENARIOS.md (the
# test-scenario coverage catalog), and FULL_TRANSFER_FLOW.md (the precise,
# code-accurate per-method flowchart) -- all linked from README.md -- per explicit
# user direction, each pushed so it's available in any clone/session.
*.md
!/README.md
!/CLAUDE.md
!/DIALOG_HANDLING.md
!/TEST_SCENARIOS.md
!/FULL_TRANSFER_FLOW.md
!/TARGET_STATE_MACHINE.md
# testdata seeding usage guide -- pushed so it ships with the scripts.
!/testdata/README.md
!/BENCHMARKING_PLAN.md

# Dev/debug scripts used only for building this framework locally (manual, piecemeal
# testing of one flow/component at a time) -- never meant to be pushed. Kept on disk,
# just untracked from git.
tools/

# Status-tracking doc -- local-only (per explicit user direction, same as tools/ above).
# Already caught by the blanket *.md rule above since it's IMPLEMENTATION_STATUS.md, but
# named explicitly too so this stays true even if a non-.md file is ever added here.
tracking/

# Migration benchmark output (benchmark/output/<run_id>/)
benchmark/output/*
!benchmark/output/.gitkeep

# Test-data seeding manifests + lock-holder PID (testdata/seed_*.ps1 generate these at
# runtime, per-machine -- never committed, same reasoning as the output folders above).
testdata/output/*
!testdata/output/.gitkeep
